{
  "name": "penpot-ai-plugin",
  "version": "1.0.0",
  "description": "AI-powered Penpot plugin",
  "private": true,
  "type": "module",
  "keywords": [
    "penpot",
    "plugin",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "vite build --watch",
    "dev:multi-user": "cross-env MULTI_USER_MODE=true vite build --watch",
    "build": "tsc && vite build",
    "build:multi-user": "tsc && cross-env MULTI_USER_MODE=true vite build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules/.vite",
    "validate": "npm run type-check && npm run lint && npm run test"
  },
  "dependencies": {
    "@penpot/plugin-styles": "^1.3.2",
    "@penpot/plugin-types": "^1.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vite-live-preview": "^0.3.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/vite-env.d.ts",
      "!src/main.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
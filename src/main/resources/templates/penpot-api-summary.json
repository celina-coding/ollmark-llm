{
  "version": "2.0.0",
  "lastUpdate": "2025-11-18",
  "source": "Penpot Plugin API Documentation",
  "description": "Documentation structurée de l'API Penpot pour génération de code optimisée - Méthodes officielles uniquement",
  
  "categories": {
    "SHAPE_CREATION": {
      "description": "Méthodes pour créer des formes géométriques",
      "keywords": ["créer", "forme", "rectangle", "ellipse", "cercle", "path", "board", "frame"]
    },
    "TEXT": {
      "description": "Méthodes pour gérer le texte et la typographie",
      "keywords": ["texte", "text", "police", "font", "typographie"]
    },
    "ORGANIZATION": {
      "description": "Méthodes pour organiser, aligner et grouper les formes",
      "keywords": ["groupe", "aligner", "distribuer", "organiser", "positionner"]
    },
    "STYLING": {
      "description": "Méthodes et propriétés pour styliser les formes",
      "keywords": ["couleur", "remplissage", "contour", "opacité", "rotation", "style"]
    },
    "MEDIA": {
      "description": "Méthodes pour gérer les médias (images, uploads)",
      "keywords": ["image", "media", "upload", "photo"]
    },
    "INTERACTION": {
      "description": "Méthodes pour ajouter des interactions et actions",
      "keywords": ["interaction", "clic", "événement", "action", "trigger"]
    },
    "EXPORT": {
      "description": "Méthodes pour exporter des formes",
      "keywords": ["export", "exporter", "sauvegarder", "png", "svg"]
    }
  },

  "methods": [
    {
      "name": "createRectangle",
      "description": "Crée un rectangle sur le canevas",
      "returnType": "Shape",
      "categories": ["SHAPE_CREATION", "STYLING"],
      "parameters": [],
      "chainableMethods": {
        "resize": {
          "signature": "resize(width: number, height: number): Shape",
          "description": "Définit les dimensions du rectangle"
        },
        "rotate": {
          "signature": "rotate(angle: number, center?: {x: number, y: number}): Shape",
          "description": "Applique une rotation en degrés"
        }
      },
      "commonUsage": [
        "const rect = penpot.createRectangle();",
        "rect.resize(100, 50);",
        "rect.x = 100; rect.y = 100;",
        "rect.fills = [{fillColor: '#FF0000'}];"
      ],
      "relatedMethods": ["createEllipse", "createPath", "createBoard"],
      "notes": "Utilisez resize() pour définir les dimensions. Les propriétés width/height sont en lecture seule."
    },
    {
      "name": "createEllipse",
      "description": "Crée une ellipse sur le canevas (cercle si largeur = hauteur)",
      "returnType": "Shape",
      "categories": ["SHAPE_CREATION", "STYLING"],
      "parameters": [],
      "chainableMethods": {
        "resize": {
          "signature": "resize(width: number, height: number): Shape",
          "description": "Définit les dimensions de l'ellipse"
        },
        "rotate": {
          "signature": "rotate(angle: number, center?: {x: number, y: number}): Shape",
          "description": "Applique une rotation"
        }
      },
      "commonUsage": [
        "const circle = penpot.createEllipse();",
        "circle.resize(100, 100);",
        "circle.fills = [{fillColor: '#0000FF'}];"
      ],
      "relatedMethods": ["createRectangle", "createPath"],
      "notes": "Pour un cercle parfait, utilisez la même valeur pour width et height"
    },
    {
      "name": "createPath",
      "description": "Crée un chemin vectoriel personnalisé",
      "returnType": "Shape",
      "categories": ["SHAPE_CREATION"],
      "parameters": [],
      "chainableMethods": {
        "resize": {
          "signature": "resize(width: number, height: number): Shape",
          "description": "Redimensionne le path"
        },
        "rotate": {
          "signature": "rotate(angle: number, center?: {x: number, y: number}): Shape",
          "description": "Fait pivoter le path"
        }
      },
      "commonUsage": [
        "const path = penpot.createPath();"
      ],
      "relatedMethods": ["createRectangle", "createEllipse", "createBoolean"],
      "notes": "Permet de créer des formes vectorielles complexes"
    },
    {
      "name": "createBoolean",
      "description": "Crée une forme résultant d'une opération booléenne sur plusieurs formes",
      "returnType": "Shape | null",
      "categories": ["SHAPE_CREATION"],
      "parameters": [
        {
          "name": "boolType",
          "type": "'union' | 'difference' | 'exclude' | 'intersection'",
          "required": true,
          "description": "Type d'opération booléenne à appliquer"
        },
        {
          "name": "shapes",
          "type": "Array<Shape>",
          "required": true,
          "description": "Formes sur lesquelles appliquer l'opération"
        }
      ],
      "chainableMethods": {
        "resize": {
          "signature": "resize(width: number, height: number): Shape",
          "description": "Redimensionne la forme booléenne"
        },
        "rotate": {
          "signature": "rotate(angle: number, center?: {x: number, y: number}): Shape",
          "description": "Fait pivoter la forme booléenne"
        }
      },
      "commonUsage": [
        "const shape1 = penpot.createRectangle();",
        "const shape2 = penpot.createEllipse();",
        "const union = penpot.createBoolean('union', [shape1, shape2]);"
      ],
      "relatedMethods": ["createPath"],
      "notes": "Retourne null si l'opération échoue"
    },
    {
      "name": "createBoard",
      "description": "Crée un board (artboard/frame), conteneur principal pour organiser les formes",
      "returnType": "Shape",
      "categories": ["SHAPE_CREATION", "ORGANIZATION"],
      "parameters": [],
      "chainableMethods": {
        "appendChild": {
          "signature": "appendChild(shape: Shape): void",
          "description": "Ajoute une forme enfant au board"
        },
        "addFlexLayout": {
          "signature": "addFlexLayout(): void",
          "description": "Ajoute un layout flexible au board"
        },
        "addGridLayout": {
          "signature": "addGridLayout(): void",
          "description": "Ajoute un layout en grille au board"
        },
        "resize": {
          "signature": "resize(width: number, height: number): Shape",
          "description": "Définit les dimensions du board"
        }
      },
      "commonUsage": [
        "const board = penpot.createBoard();",
        "board.resize(1920, 1080);",
        "board.appendChild(shape);"
      ],
      "relatedMethods": ["group"],
      "notes": "Le board est le conteneur principal dans Penpot, similaire à un artboard dans d'autres outils"
    },
    {
      "name": "clone",
      "description": "Crée une copie identique d'une forme",
      "returnType": "Shape",
      "categories": ["SHAPE_CREATION"],
      "parameters": [],
      "isMethodOf": "Shape",
      "commonUsage": [
        "const rect = penpot.createRectangle();",
        "const copy = rect.clone();"
      ],
      "relatedMethods": ["createRectangle", "createEllipse"],
      "notes": "Retourne une nouvelle instance avec les mêmes propriétés"
    },
    {
      "name": "createText",
      "description": "Crée une forme de texte sur le canevas",
      "returnType": "Shape | null",
      "categories": ["TEXT", "SHAPE_CREATION"],
      "parameters": [
        {
          "name": "text",
          "type": "string",
          "required": false,
          "defaultValue": "''",
          "description": "Contenu textuel initial"
        }
      ],
      "textProperties": {
        "fontId": "string - ID de la police (à définir en premier)",
        "fontFamily": "string - Nom de la famille de police",
        "fontStyle": "'normal' | 'italic'",
        "fontWeight": "string - Poids de la police (100-900)",
        "fontSize": "number - Taille de la police",
        "textAlign": "'left' | 'center' | 'right' | 'justify'",
        "lineHeight": "number - Hauteur de ligne"
      },
      "commonUsage": [
        "const text = penpot.createText('Hello World');",
        "text.fontId = 'font-id';",
        "text.fontSize = 24;",
        "text.fills = [{fillColor: '#000000'}];"
      ],
      "relatedMethods": ["applyToText"],
      "notes": "Appliquez fontId AVANT fontStyle ou fontWeight pour éviter les erreurs"
    },
    {
      "name": "applyToText",
      "description": "Applique des styles de police à une forme de texte",
      "returnType": "void",
      "categories": ["TEXT", "STYLING"],
      "parameters": [
        {
          "name": "text",
          "type": "Shape",
          "required": true,
          "description": "La forme de texte à styliser"
        }
      ],
      "isMethodOf": "Font",
      "commonUsage": [
        "font.applyToText(textShape, fontVariant);"
      ],
      "relatedMethods": ["createText"],
      "notes": "Utilisé pour appliquer des variantes de police"
    },
    {
      "name": "group",
      "description": "Groupe plusieurs formes en un seul groupe",
      "returnType": "Shape | null",
      "categories": ["ORGANIZATION"],
      "parameters": [
        {
          "name": "shapes",
          "type": "Array<Shape>",
          "required": true,
          "description": "Formes à regrouper"
        }
      ],
      "commonUsage": [
        "const shapes = [shape1, shape2, shape3];",
        "const group = penpot.group(shapes);",
        "// Ou avec la sélection:",
        "const group = penpot.group(penpot.selection);"
      ],
      "relatedMethods": ["ungroup", "createBoard"],
      "notes": "Retourne null si le regroupement échoue. Utile pour manipuler plusieurs éléments ensemble"
    },
    {
      "name": "ungroup",
      "description": "Dégroupe un ou plusieurs groupes de formes",
      "returnType": "void",
      "categories": ["ORGANIZATION"],
      "parameters": [
        {
          "name": "group",
          "type": "Group",
          "required": true,
          "description": "Le groupe à dégrouper"
        },
        {
          "name": "others",
          "type": "Array<Group>",
          "required": false,
          "description": "Autres groupes à dégrouper"
        }
      ],
      "commonUsage": [
        "penpot.ungroup(group);",
        "// Ou avec plusieurs groupes:",
        "penpot.ungroup(group1, [group2, group3]);"
      ],
      "relatedMethods": ["group"],
      "notes": "Sépare les éléments du groupe, les rendant indépendants"
    },
    {
      "name": "alignHorizontal",
      "description": "Aligne plusieurs formes horizontalement",
      "returnType": "void",
      "categories": ["ORGANIZATION"],
      "parameters": [
        {
          "name": "shapes",
          "type": "Array<Shape>",
          "required": true,
          "description": "Formes à aligner"
        },
        {
          "name": "direction",
          "type": "'left' | 'center' | 'right'",
          "required": true,
          "description": "Direction d'alignement"
        }
      ],
      "commonUsage": [
        "const selected = penpot.selection;",
        "penpot.alignHorizontal(selected, 'center');"
      ],
      "relatedMethods": ["alignVertical", "distributeHorizontal"],
      "notes": "L'alignement se fait par rapport à une des formes sélectionnées"
    },
    {
      "name": "alignVertical",
      "description": "Aligne plusieurs formes verticalement",
      "returnType": "void",
      "categories": ["ORGANIZATION"],
      "parameters": [
        {
          "name": "shapes",
          "type": "Array<Shape>",
          "required": true,
          "description": "Formes à aligner"
        },
        {
          "name": "direction",
          "type": "'top' | 'center' | 'bottom'",
          "required": true,
          "description": "Direction d'alignement"
        }
      ],
      "commonUsage": [
        "const selected = penpot.selection;",
        "penpot.alignVertical(selected, 'top');"
      ],
      "relatedMethods": ["alignHorizontal", "distributeVertical"],
      "notes": "L'alignement se fait par rapport à une des formes sélectionnées"
    },
    {
      "name": "distributeHorizontal",
      "description": "Distribue les formes avec un espacement horizontal égal",
      "returnType": "void",
      "categories": ["ORGANIZATION"],
      "parameters": [
        {
          "name": "shapes",
          "type": "Array<Shape>",
          "required": true,
          "description": "Formes à distribuer"
        }
      ],
      "commonUsage": [
        "const selected = penpot.selection;",
        "penpot.distributeHorizontal(selected);"
      ],
      "relatedMethods": ["distributeVertical", "alignHorizontal"],
      "notes": "Ajuste automatiquement la position pour un espacement uniforme"
    },
    {
      "name": "distributeVertical",
      "description": "Distribue les formes avec un espacement vertical égal",
      "returnType": "void",
      "categories": ["ORGANIZATION"],
      "parameters": [
        {
          "name": "shapes",
          "type": "Array<Shape>",
          "required": true,
          "description": "Formes à distribuer"
        }
      ],
      "commonUsage": [
        "const selected = penpot.selection;",
        "penpot.distributeVertical(selected);"
      ],
      "relatedMethods": ["distributeHorizontal", "alignVertical"],
      "notes": "Ajuste automatiquement la position pour un espacement uniforme"
    },
    {
      "name": "uploadMediaData",
      "description": "Upload un média (image) vers Penpot depuis des données binaires",
      "returnType": "Promise<ImageData>",
      "categories": ["MEDIA"],
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "Nom du média"
        },
        {
          "name": "data",
          "type": "Uint8Array",
          "required": true,
          "description": "Données binaires du média"
        },
        {
          "name": "mimeType",
          "type": "string",
          "required": true,
          "description": "Type MIME (ex: 'image/jpeg', 'image/png')"
        }
      ],
      "commonUsage": [
        "const imageData = await penpot.uploadMediaData('photo', bytes, 'image/jpeg');"
      ],
      "relatedMethods": ["uploadMediaUrl"],
      "notes": "Retourne une Promise. Utilisez await ou .then()"
    },
    {
      "name": "uploadMediaUrl",
      "description": "Upload un média (image) vers Penpot depuis une URL",
      "returnType": "Promise<ImageData>",
      "categories": ["MEDIA"],
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "Nom du média"
        },
        {
          "name": "url",
          "type": "string",
          "required": true,
          "description": "URL du média à uploader"
        }
      ],
      "commonUsage": [
        "const imageData = await penpot.uploadMediaUrl('logo', 'https://example.com/logo.png');"
      ],
      "relatedMethods": ["uploadMediaData"],
      "notes": "Retourne une Promise. L'URL doit être accessible publiquement"
    },
    {
      "name": "addInteraction",
      "description": "Ajoute une interaction (événement + action) à une forme",
      "returnType": "Interaction",
      "categories": ["INTERACTION"],
      "parameters": [
        {
          "name": "trigger",
          "type": "'click' | 'mouse-enter' | 'mouse-leave' | 'after-delay'",
          "required": true,
          "description": "Événement déclencheur"
        },
        {
          "name": "action",
          "type": "Action",
          "required": true,
          "description": "Action à exécuter"
        },
        {
          "name": "delay",
          "type": "number",
          "required": false,
          "description": "Délai en ms (uniquement pour 'after-delay')"
        }
      ],
      "isMethodOf": "Shape",
      "commonUsage": [
        "shape.addInteraction('click', { type: 'navigate-to', destination: board });"
      ],
      "relatedMethods": ["removeInteraction"],
      "notes": "Permet de créer des prototypes interactifs"
    },
    {
      "name": "removeInteraction",
      "description": "Supprime une interaction d'une forme",
      "returnType": "void",
      "categories": ["INTERACTION"],
      "parameters": [
        {
          "name": "interaction",
          "type": "Interaction",
          "required": true,
          "description": "L'interaction à supprimer"
        }
      ],
      "isMethodOf": "Shape",
      "commonUsage": [
        "shape.removeInteraction(interaction);"
      ],
      "relatedMethods": ["addInteraction"],
      "notes": "L'objet interaction doit être celui retourné par addInteraction()"
    },
    {
      "name": "export",
      "description": "Exporte une forme dans un format spécifié",
      "returnType": "Promise<Uint8Array>",
      "categories": ["EXPORT"],
      "parameters": [
        {
          "name": "config",
          "type": "Export",
          "required": true,
          "description": "Configuration de l'export"
        }
      ],
      "isMethodOf": "Shape",
      "commonUsage": [
        "const pngData = await shape.export({ type: 'png', scale: 2 });",
        "const svgData = await shape.export({ type: 'svg' });"
      ],
      "relatedMethods": [],
      "notes": "Retourne une Promise avec les données binaires. Formats: svg, png, jpeg, pdf"
    }
  ],

  "commonProperties": {
    "Shape": {
      "description": "Propriétés communes à toutes les formes",
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true,
          "description": "Identifiant unique de la forme"
        },
        "type": {
          "type": "string",
          "readOnly": true,
          "description": "Type de forme (rect, ellipse, text, path, etc.)"
        },
        "name": {
          "type": "string",
          "description": "Nom de la forme (modifiable)"
        },
        "x": {
          "type": "number",
          "description": "Position X dans le canevas"
        },
        "y": {
          "type": "number",
          "description": "Position Y dans le canevas"
        },
        "width": {
          "type": "number",
          "readOnly": true,
          "description": "Largeur (utilisez resize() pour modifier)"
        },
        "height": {
          "type": "number",
          "readOnly": true,
          "description": "Hauteur (utilisez resize() pour modifier)"
        },
        "rotation": {
          "type": "number",
          "description": "Rotation en degrés (0-360)"
        },
        "flipX": {
          "type": "boolean",
          "description": "Miroir horizontal"
        },
        "flipY": {
          "type": "boolean",
          "description": "Miroir vertical"
        },
        "borderRadius": {
          "type": "number",
          "description": "Rayon des coins arrondis (pour rectangles)"
        },
        "blocked": {
          "type": "boolean",
          "description": "Forme verrouillée (non modifiable)"
        },
        "hidden": {
          "type": "boolean",
          "description": "Forme masquée (invisible)"
        },
        "opacity": {
          "type": "number",
          "description": "Opacité (0-1, null = opaque)",
          "defaultValue": 1
        },
        "blendMode": {
          "type": "string",
          "description": "Mode de fusion (normal, multiply, screen, etc.)"
        },
        "fills": {
          "type": "Array<Fill>",
          "description": "Remplissages de la forme"
        },
        "strokes": {
          "type": "Array<Stroke>",
          "description": "Contours de la forme"
        },
        "parent": {
          "type": "Shape | null",
          "readOnly": true,
          "description": "Forme parente (board ou groupe)"
        },
        "bounds": {
          "type": "Bounds",
          "readOnly": true,
          "description": "Limites rectangulaires de la forme"
        },
        "center": {
          "type": "Point",
          "readOnly": true,
          "description": "Point central de la forme"
        },
        "parentX": {
          "type": "number",
          "description": "Position X relative au parent"
        },
        "parentY": {
          "type": "number",
          "description": "Position Y relative au parent"
        }
      }
    },
    "Fill": {
      "description": "Configuration du remplissage d'une forme",
      "properties": {
        "fillColor": {
          "type": "string", 
          "description": "Couleur au format hex (#RRGGBB ou #RRGGBBAA)",
          "example": "#FF0000"
        },
        "fillOpacity": {
          "type": "number",
          "description": "Opacité du remplissage (0-1)", 
          "defaultValue": 1
        },
        "fillImage": {
          "type": "ImageData",
          "description": "Image de remplissage (utiliser avec uploadMediaUrl/uploadMediaData)",
          "notes": "⚠️ Peut avoir des problèmes de validation dans certaines versions"
        }
      },
      "usage": [
        "shape.fills = [{fillColor: '#FF0000', fillOpacity: 0.8}];",
        "shape.fills = [{fillImage: imageData}];"
      ]
    },
    "Stroke": {
      "description": "Configuration du contour d'une forme",
      "properties": {
        "strokeColor": {
          "type": "string",
          "description": "Couleur du contour (format hex)",
          "example": "#000000"
        },
        "strokeWidth": {
          "type": "number",
          "description": "Épaisseur du contour en pixels",
          "defaultValue": 1
        },
        "strokeStyle": {
          "type": "'solid' | 'dotted' | 'dashed'",
          "description": "Style du trait",
          "defaultValue": "solid"
        },
        "strokeAlignment": {
          "type": "'center' | 'inner' | 'outer'",
          "description": "Alignement du contour par rapport au bord",
          "defaultValue": "center"
        }
      },
      "usage": "shape.strokes = [{strokeColor: '#000', strokeWidth: 2, strokeStyle: 'solid'}];"
    },
    "Bounds": {
      "description": "Limites rectangulaires d'une forme",
      "properties": {
        "x": {"type": "number", "description": "Position X du coin supérieur gauche"},
        "y": {"type": "number", "description": "Position Y du coin supérieur gauche"},
        "width": {"type": "number", "description": "Largeur totale"},
        "height": {"type": "number", "description": "Hauteur totale"}
      },
      "usage": "const bounds = shape.bounds;"
    },
    "Point": {
      "description": "Coordonnées d'un point",
      "properties": {
        "x": {"type": "number", "description": "Coordonnée X"},
        "y": {"type": "number", "description": "Coordonnée Y"}
      },
      "usage": "const center = shape.center;"
    },
    "ImageData": {
      "description": "Données d'une image uploadée",
      "properties": {
        "id": {"type": "string", "description": "ID unique de l'image"},
        "name": {"type": "string", "description": "Nom de l'image"},
        "width": {"type": "number", "description": "Largeur en pixels"},
        "height": {"type": "number", "description": "Hauteur en pixels"},
        "mtype": {"type": "string", "description": "Type MIME de l'image"}
      }
    },
    "Interaction": {
      "description": "Interaction (événement + action) sur une forme",
      "properties": {
        "shape": {"type": "Shape", "description": "Forme ayant l'interaction"},
        "trigger": {"type": "Trigger", "description": "Événement déclencheur"},
        "delay": {"type": "number | null", "description": "Délai en ms (pour after-delay)"},
        "action": {"type": "Action", "description": "Action à exécuter"}
      }
    },
    "Action": {
      "description": "Action à exécuter lors d'une interaction",
      "properties": {
        "type": {"type": "string", "description": "Type d'action (navigate-to, open-url, etc.)"},
        "url": {"type": "string", "description": "URL (pour open-url)"}
      }
    },
    "Export": {
      "description": "Configuration pour exporter une forme",
      "properties": {
        "type": {"type": "'svg' | 'png' | 'jpeg' | 'pdf'", "description": "Format d'export"},
        "scale": {"type": "number", "description": "Échelle d'export (1 = 100%)", "defaultValue": 1},
        "suffix": {"type": "string", "description": "Suffixe ajouté au nom du fichier"},
        "skipChildren": {"type": "boolean", "description": "Ignorer les formes enfants", "defaultValue": false}
      },
      "usage": "await shape.export({type: 'png', scale: 2});"
    },
    "Font": {
      "description": "Configuration de police de caractères",
      "properties": {
        "name": {"type": "string", "description": "Nom de la police"},
        "fontId": {"type": "string", "description": "ID unique de la police"},
        "fontFamily": {"type": "string", "description": "Famille de police"},
        "fontStyle": {"type": "'normal' | 'italic' | null", "description": "Style de la police"},
        "fontWeight": {"type": "string", "description": "Poids (100-900)"}
      }
    }
  },

  "utilities": {
    "penpot.selection": {
      "type": "Array<Shape>",
      "description": "Formes actuellement sélectionnées par l'utilisateur",
      "usage": "const selected = penpot.selection;"
    },
    "penpot.currentPage": {
      "type": "Page",
      "description": "Page actuellement active",
      "usage": "const page = penpot.currentPage;"
    },
    "penpot.viewport.center": {
      "type": "Point",
      "description": "Centre du viewport actuel {x, y}",
      "usage": "const center = penpot.viewport.center;"
    },
    "penpot.theme": {
      "type": "'dark' | 'light'",
      "description": "Thème actuel de l'interface",
      "usage": "const theme = penpot.theme;"
    },
    "penpot.utils.types.isGroup": {
      "type": "function",
      "signature": "isGroup(shape: Shape): boolean",
      "description": "Vérifie si une forme est un groupe",
      "usage": "if (penpot.utils.types.isGroup(shape)) { ... }"
    },
    "penpot.library.local": {
      "type": "LocalLibrary",
      "description": "Bibliothèque locale (composants, couleurs, typographies)",
      "usage": "const library = penpot.library.local;"
    }
  },

  "commonPatterns": {
    "centerShape": {
      "description": "Centrer une forme dans le viewport",
      "code": [
        "const center = penpot.viewport.center;",
        "shape.x = center.x - (shape.width / 2);",
        "shape.y = center.y - (shape.height / 2);"
      ]
    },
    "createColoredRectangle": {
      "description": "Créer un rectangle avec couleur",
      "code": [
        "const rect = penpot.createRectangle();",
        "rect.resize(100, 50);",
        "rect.fills = [{fillColor: '#FF0000'}];"
      ]
    },
    "createCircle": {
      "description": "Créer un cercle parfait",
      "code": [
        "const circle = penpot.createEllipse();",
        "circle.resize(100, 100);"
      ]
    },
    "groupSelection": {
      "description": "Grouper les formes sélectionnées",
      "code": [
        "const group = penpot.group(penpot.selection);"
      ]
    },
    "alignSelectionCenter": {
      "description": "Aligner la sélection au centre",
      "code": [
        "penpot.alignHorizontal(penpot.selection, 'center');",
        "penpot.alignVertical(penpot.selection, 'center');"
      ]
    },
    "uploadAndUseImage": {
      "description": "Workflow pour uploader et utiliser une image",
      "code": [
        "const imageData = await penpot.uploadMediaUrl('background', 'https://example.com/image.jpg');",
        "const rect = penpot.createRectangle();",
        "rect.resize(400, 300);",
        "rect.x = 100; rect.y = 100;",
        "// Note: L'application d'images comme remplissage peut avoir des limitations"
      ]
    }
  },

  "importantNotes": [
    "Utilisez uploadMediaUrl et uploadMediaData pour gérer les images",
    "Les méthodes async (uploadMedia, export) nécessitent await ou .then()",
    "Utilisez toujours resize() pour définir les dimensions, width/height sont en lecture seule",
    "Pour createText(), définissez fontId AVANT fontStyle ou fontWeight",
    "penpot.viewport.center est utile pour centrer les formes",
    "Les fills et strokes sont des tableaux, vous pouvez avoir plusieurs remplissages/contours",
    "Pour un cercle parfait avec createEllipse(), utilisez la même valeur pour width et height",
    "group() retourne null si le regroupement échoue, vérifiez toujours le résultat",
    "Les opérations booléennes (createBoolean) nécessitent au moins 2 formes"
  ]
}